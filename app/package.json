{
  "name": "patchbay",
  "version": "0.1.3",
  "private": true,
  "description": "Launcher for qc-mcp — installs the MCP, runs the daemon, opens Cortex Control",
  "author": "lexasoft <lexasoft@gmail.com>",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "dist": "npm run fetch:uv && npm run build && electron-builder --publish never",
    "dist:mac": "npm run fetch:uv && npm run build && electron-builder --mac dmg:arm64 --publish never && electron-builder --mac dmg:x64 --publish never",
    "dist:win": "npm run fetch:uv && npm run build && electron-builder --win --publish never",
    "fetch:uv": "node scripts/fetch-uv.mjs",
    "icons": "electron build/icon/build-icons.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.5",
    "@fontsource-variable/martian-mono": "^5.1.1",
    "@singz/ui": "https://github.com/lexasoft123/singz-ui/archive/refs/tags/v1.5.0.tar.gz",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
